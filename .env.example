# ---------------------------------------------------------------------------
# Trio Sabores — variáveis de ambiente
#
# Uso:  cp .env.example .env   e preencha os valores.
# Nunca faça commit do arquivo `.env` (ele está no .gitignore).
#
# Obrigatória = a aplicação não funciona sem ela.
# Produção    = precisa ser configurada na Vercel antes do deploy.
# ---------------------------------------------------------------------------

# [OBRIGATÓRIA] Conexão usada pela aplicação em runtime (pooler do provedor).
# Em produção use o endpoint de *pooling* com SSL:
#   postgresql://usuario:senha@host/db?sslmode=verify-full
DATABASE_URL="postgresql://trio:trio@localhost:5432/trio_sabores?schema=public"

# [OBRIGATÓRIA para Prisma CLI] Conexão direta usada por migrations/seed.
# Em provedores com pooling, aponte para o host direto (sem -pooler).
# Mantenha `sslmode=verify-full` para validar certificado e hostname.
DIRECT_URL="postgresql://trio:trio@localhost:5432/trio_sabores?schema=public"

# [OBRIGATÓRIA] Chave de assinatura dos JWT (HS256). Mínimo de 32 bytes.
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Produção: valor único e secreto. Nunca reutilize entre ambientes.
JWT_SECRET=""

# [OBRIGATÓRIA apenas ao criar/redefinir o admin inicial]
# Usada por `npm run db:seed`. Mínimo 16 bytes em produção, 8 em desenvolvimento.
# Em produção não existe senha padrão: sem esta variável o seed falha.
ADMIN_INITIAL_PASSWORD=""

# [OBRIGATÓRIA] URL pública da loja. Base de metadata, sitemap e links absolutos.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [OBRIGATÓRIA] WhatsApp de contato/pedidos (somente dígitos, com DDI+DDD).
NEXT_PUBLIC_WHATSAPP_NUMBER="5521999999999"

# [OBRIGATÓRIA em produção] Armazenamento de imagens (Vercel Blob).
# Sem este token em produção o upload retorna 503 — não há fallback para disco.
# Desenvolvimento: se vazio, as imagens são gravadas em public/uploads.
BLOB_READ_WRITE_TOKEN=""

# [OPCIONAL — reservado] Pagamento ainda opera em modo demonstrativo.
# O código atual não lê estas variáveis; preencha quando a integração real
# de pagamento for ativada.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""

# [OPCIONAL] Coordenadas da loja para cálculo/validação de entrega.
# Não são lidas pelo código atual; mantidas para integrações de rota.
STORE_LATITUDE="-22.9068"
STORE_LONGITUDE="-43.1729"

# [OPCIONAL — desenvolvimento] Origens adicionais aceitas pelo `next dev`
# (acesso pela rede local). Lista separada por vírgulas, valores EXATOS.
# O Next.js não interpreta wildcards/CIDR. Ex.: 192.168.1.15,meu-notebook.local
DEV_ALLOWED_ORIGINS=""
